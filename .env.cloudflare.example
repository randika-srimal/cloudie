# Copy to .env.cloudflare (ignored by Git and Docker), or let `./cli.sh tokens` write it for you.
# Admin token: Terraform (everything on the account except managing tokens)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Least-privilege token for Wrangler in GitHub Actions (Pages Write, Account Settings Read)
CLOUDFLARE_DEPLOY_TOKEN=
# The Terraform state bucket's S3 key pair
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
