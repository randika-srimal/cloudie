# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The chat page, embedded by HubSpot in an iframe. frame-ancestors lists who may embed it (a <meta> CSP cannot
# say that); Turnstile runs in a frame from challenges.cloudflare.com; the chat WebSocket and history GET go to
# this site only; no remote images or form posts. script-src (with the hash of SvelteKit's inline start-up script) is the <meta> CSP from
# `csp` in web/vite.config.ts.
# TODO(user): confirm the HubSpot page origin
/chat
  Content-Security-Policy: frame-ancestors 'self' https://www.engaging.io https://*.engaging.io https://*.hubspot.com https://*.hs-sites.com; frame-src https://challenges.cloudflare.com; connect-src 'self'; img-src 'self' data:; form-action 'none'

# Hashed build files never change: cache them for a year
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
