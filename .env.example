# Copy to .env (ignored by Git) to change the ports on your computer, e.g. when another project
# made from this starter is running at the same time. Docker Compose reads it automatically.
WEB_PORT=5173
API_PORT=8788
DOCS_PORT=3000
SHARE_PORT=8790
# Set true on Windows/macOS if edits don't trigger a reload
CHOKIDAR_USEPOLLING=false
